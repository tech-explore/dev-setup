# Commonly generated folders
# Maven
**/target/
**/dist/

# Eclipse
**/.classpath
**/.project
**/.settings/
**/bin

# VSCode
**/.vscode/
.vscode

# IntelliJ
**/.idea
**/*.iml

# Robot Framework
**/results/

# Compiled class file
*.class
**/*.class

# Log file
*.log
**/*.log
**/*.log.gz

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

